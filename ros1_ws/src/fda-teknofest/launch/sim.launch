<?xml version="1.0"?>
<!--
  HTAB arenasını Gazebo'da açar (worlds/arena.world).

  models/ altındaki modeller model://<isim> URI'siyle include ediliyor
  (bkz. worlds/arena.world), bu yüzden GAZEBO_MODEL_PATH'e paketin
  models/ dizinini eklemek gerekiyor.

  Henüz bir İHA modeli/URDF yok, bu launch dosyası sadece sahneyi açar.
-->
<launch>

  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="debug" default="false"/>
  <arg name="verbose" default="false"/>

  <env name="GAZEBO_MODEL_PATH" value="$(find fda-teknofest)/models:$(optenv GAZEBO_MODEL_PATH)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find fda-teknofest)/worlds/arena.world"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="verbose" value="$(arg verbose)"/>
  </include>

</launch>
