<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="rubble_pile">
    <static>true</static>
    <link name="base_link">
      
      <collision name="collision">
        <pose>0 0 0.5 0 1.57 0</pose>
        <geometry>
          <box>
            <size>4.0 3.0 1.0</size>
          </box>
        </geometry>
      </collision>

      <!-- Visual pose değerini Z ekseninde yukarı kaldırıyoruz (Örn: 0.5m) -->
      <visual name="visual">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://rubble_pile/meshes/debris.obj</uri>
            <scale>0.1 0.1 0.1</scale>
          </mesh>
        </geometry>
      </visual>

    </link>
  </model>
</sdf>
