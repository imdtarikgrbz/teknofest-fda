    <model name='camera'>
      <static>1</static>
      <pose>0 0 10 0 1.5708 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <!-- ═══════════════════════════════════════════════════════════
             Raspberry Pi Global Shutter Camera + RPI-6MM LENS

             Sensör: Sony IMX296LQR-C
               1456 x 1088 px · 3.45 um piksel · 6.27 mm diagonal
             Lens: 6 mm odak, CS-mount, F1.2

             TÜRETME (piksel boyutu ve odak uzaklığından):
               sensör genişliği = 1456 x 3.45um = 5.0232 mm
               sensör yüksekliği = 1088 x 3.45um = 3.7536 mm
               hfov = 2*atan(5.0232 / (2*6.0)) = 0.792875 rad (45.43°)
               fx = fy = 6.0 mm / 0.00345 mm = 1739.1304 px  (native)

             Lens datasheet'i 63° diyor ama o değer lensin taşıyabildiği
             1/2" formata ait. IMX296 daha küçük (6.27 mm diagonal), o
             yüzden gerçekte elde edilen diagonal FOV 55.18°.

             RENDER ÇÖZÜNÜRLÜĞÜ: sensörün native değeri (1456x1088).
             Gerçek donanımla BİREBİR aynı olması kasıtlı — sim ile
             saha testi arasında YOLO'nun gördüğü görüntü, ROI'ler ve
             piksel eşikleri farklılaşmasın diye. Düşürmek render yükünü
             azaltır ama sim-to-real farkı açar.

             DİKKAT: bu değerler değişirse scripts/ içindeki CostMap'e
             verilen fx/fy/cx/cy de AYNI anda güncellenmeli — iki taraf
             ayrışırsa zemin projeksiyonu sessizce kayar.

             Global shutter: Gazebo kamera sensörü zaten rolling shutter
             simüle etmiyor, yani sim bu açıdan gerçek donanıma uygun.
             ═══════════════════════════════════════════════════════════ -->
        <sensor name='camera' type='camera'>
          <camera name='camera'>
            <horizontal_fov>0.792875</horizontal_fov>
            <image>
              <width>1456</width>
              <height>1088</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.007</stddev>
            </noise>
            <!-- Gerçek lensin distorsiyonu ölçülmedi; checkerboard
                 kalibrasyonundan (camera_calibration) çıkan k1,k2,k3,
                 p1,p2 değerleri buraya yazılmalı. Şimdilik ideal lens. -->
            <distortion>
              <k1>0.0</k1>
              <k2>0.0</k2>
              <k3>0.0</k3>
              <p1>0.0</p1>
              <p2>0.0</p2>
              <center>0.5 0.5</center>
            </distortion>
            <lens>
              <type>gnomonical</type>
              <scale_to_hfov>true</scale_to_hfov>
              <intrinsics>
                <fx>1739.1304347826087</fx>
                <fy>1739.1304347826087</fy>
                <cx>728.0</cx>
                <cy>544.0</cy>
                <s>0.0</s>
              </intrinsics>
            </lens>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>1</visualize>
          <plugin name='camera_controller' filename='libgazebo_ros_camera.so'>
            <alwaysOn>true</alwaysOn>
            <updateRate>30</updateRate>
            <cameraName>camera</cameraName>
            <imageTopicName>image_raw</imageTopicName>
            <cameraInfoTopicName>camera_info</cameraInfoTopicName>
            <frameName>camera_link</frameName>
          </plugin>
        </sensor>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>
